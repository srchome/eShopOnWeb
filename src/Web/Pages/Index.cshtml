@page
@{
    ViewData["Title"] = "Catalog";
    @model IndexModel
}
<section class="esh-catalog-hero">
    <div class="container">
        <img class="esh-catalog-title" src="~/images/main_banner_text.png" />
    </div>
</section>
<section class="esh-catalog-filters">
    <div class="container">
        <form method="get" class="esh-catalog-search-form">
            <div class="esh-catalog-search-wrapper">
                <input class="esh-catalog-search-input"
                       type="search"
                       name="q"
                       value="@Model.CatalogModel.SearchQuery"
                       placeholder="Search with AI (e.g. blue .NET shirt, cosy winter hoodie)..." />
                <button class="esh-catalog-search-btn" type="submit">Search</button>
            </div>
        </form>
        @if (!string.IsNullOrEmpty(Model.CatalogModel.SearchQuery))
        {
            <p class="esh-catalog-search-results-label">
                @Model.CatalogModel.CatalogItems.Count AI-matched result(s) for &ldquo;<strong>@Model.CatalogModel.SearchQuery</strong>&rdquo;
                &mdash; <a href="/">Clear search</a>
            </p>
        }
    </div>
</section>
<div class="container">
    @if (Model.CatalogModel.CatalogItems.Any())
    {
        @if (Model.CatalogModel.PaginationInfo != null)
        {
            <partial name="_pagination" for="CatalogModel.PaginationInfo" />
        }

        <div class="esh-catalog-items row">
            @foreach (var catalogItem in Model.CatalogModel.CatalogItems)
            {
                <div class="esh-catalog-item col-md-4">
                    <partial name="_product" for="@catalogItem" />
                </div>
            }
        </div>

        @if (Model.CatalogModel.PaginationInfo != null)
        {
            <partial name="_pagination" for="CatalogModel.PaginationInfo" />
        }
    }
    else
    {
        <div class="esh-catalog-items row">
            THERE ARE NO RESULTS THAT MATCH YOUR SEARCH
        </div>
    }
</div>

@if (Model.CatalogModel.RecommendedItems.Any())
{
    <partial name="_recommendations" model="@Model.CatalogModel.RecommendedItems" />
}
