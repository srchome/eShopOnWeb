@model IEnumerable<CatalogItemViewModel>
@if (Model != null && Model.Any())
{
    <section class="esh-catalog-recommendations">
        <div class="container">
            <h3 class="esh-catalog-recommendations-title">You might also like</h3>
            <div class="esh-catalog-items row">
                @foreach (var item in Model)
                {
                    <div class="esh-catalog-item col-md-3">
                        <partial name="_product" for="@item" />
                    </div>
                }
            </div>
        </div>
    </section>
}
